  <data key="d2">chunk-737a538d85e2897e75f31df035b55774</data>
</node>
<node id="&quot;RELEVANT ORGANIZATIONS&quot;">
  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"Organizations that provide assessment and certification services for personal information protection."</data>
  <data key="d2">chunk-737a538d85e2897e75f31df035b55774</data>
</node>
<node id="&quot;PROFESSIONAL INSTITUTIONS&quot;">
  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"Organizations that conduct compliance audits of personal information processing activities."</data>
  <data key="d2">chunk-737a538d85e2897e75f31df035b55774</data>
</node>
<node id="&quot;STAFF OF DEPARTMENTS RESPONSIBLE FOR PERSONAL INFORMATION PROTECTION&quot;">
  <data key="d0">"PERSON"</data>
  <data key="d1">"Individuals working within departments responsible for personal information protection."</data>
  <data key="d2">chunk-737a538d85e2897e75f31df035b55774</data>
</node>
<node id="&quot;INDIVIDUALS CONCERNED&quot;">
  <data key="d0">"PERSON"</data>
  <data key="d1">"Individuals whose personal information has been affected by illegal processing."</data>
  <data key="d2">chunk-737a538d85e2897e75f31df035b55774</data>
</node>
